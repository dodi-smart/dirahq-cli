// The org preset plus only what is true of this repo. Never repeat a preset
// setting here: a copy stops following the preset.
// This is the only Renovate config; a second copy elsewhere is never read.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>dodi-smart/.github"],
  // The one setting deliberately repeated from the preset. develop is the default
  // branch and main only receives releases (DODI-00032); naming it here means a
  // default-branch change can never silently retarget PRs at the release branch.
  baseBranchPatterns: ["develop"],
  // Lockfile refresh (Cargo.lock + bun.lock), as its own PR.
  lockFileMaintenance: { enabled: true },
  packageRules: [
    // Batch non-major production deps into one PR. This Cargo workspace declares its
    // third-party crates in the root `[workspace.dependencies]`, so they surface under
    // that depType rather than `dependencies`.
    {
      matchDepTypes: ["dependencies", "workspace.dependencies", "build-dependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "production dependencies (non-major)",
    },
    // reqwest 0.13 is a TLS-posture change disguised as a 0.x minor: aws-lc-rs replaces
    // ring, and cert validation moves from bundled Mozilla roots to the host trust store
    // (D-0011, DIRASH-0033; see the reqwest comment in the root Cargo.toml). It needs its
    // own PR with a release-matrix build behind it, so keep it out of the weekly batch.
    {
      matchPackageNames: ["reqwest"],
      allowedVersions: "<0.13",
      description: "held: 0.13 changes the TLS provider + trust anchors; migrate deliberately",
    },
  ],
}
