{
  "name": "dirahq-cli-release",
  "version": "0.0.0",
  "private": true,
  "description": "Release & commit-convention tooling for the Dira CLI (cli + contract).",
  "scripts": {
    "release": "semantic-release --extends ./release.config.mjs",
    "release:dry-run": "semantic-release --dry-run --no-ci --extends ./release.config.mjs",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "semantic-release": "25.0.9",
    "semantic-release-scope-filter": "1.0.0"
  }
}
