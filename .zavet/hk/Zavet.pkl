// generated by `zavet adapters` — do not edit; re-run zavet adapters
//
// zavet's git-hook floor as hk steps. Wire it into hk.pkl:
//
//   import "./.zavet/hk/Zavet.pkl"
//
//   hooks {
//     ["commit-msg"] { steps { ["zavet-guard"] = Zavet.guard } }
//     ["pre-commit"] { steps { ["zavet-nudge"] = Zavet.nudge } }
//   }
//
// then run `hk install` and `.zavet/bin/zavet hooks --check`.

/// The guard wall. Blocks a commit that touches guarded paths without a
/// Refs:/Supersedes: trailer.
guard = new Dynamic {
  check = ".zavet/githooks/commit-msg {{commit_msg_file}}"
}

/// The spec-currency nudge. Warns, never fails.
nudge = new Dynamic {
  check = ".zavet/githooks/pre-commit"
}
