// Git hooks and lint for this repo, defined once. The hooks run them on commit
// (optional, see CONTRIBUTING.md), `hk check --all` runs them locally, and the
// `Lint (hk)` job of .github/workflows/ci.yml runs the same thing in CI. Tools are
// pinned in mise.toml.
//
// Keep the version in the two lines below in step with the "aqua:jdx/hk" pin in
// mise.toml.
amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

// Zavet's git-hook floor, generated by `zavet adapters` into .zavet/hk/. Re-run
// `zavet adapters` after a zavet upgrade.
import "./.zavet/hk/Zavet.pkl"

// Files no one edits by hand, or whose bytes are compared by a test. Left out of
// the trailing-whitespace check; typos.toml holds the same list for typos. The
// dialect fixtures are the upstream of the shared zavet frontmatter fixtures and
// carry trailing whitespace and odd spellings on purpose.
local generated = List(
  "Cargo.lock",
  "bun.lock",
  "CHANGELOG.md",
  ".zavet/bin/**",
  "cli/core/testdata/**"
)

// Checks that apply to every stack stay in this mapping.
local linters = new Mapping<String, Step> {
  ["actionlint"] = Builtins.actionlint
  // Offline, so an audit that asks GitHub about a ref cannot flake. No fix
  // command: a hook must not rewrite workflow permissions on its own.
  ["zizmor"] = (Builtins.zizmor) {
    check = new CommandSpec {
      command = new Command {
        argv = List("zizmor", "--offline", "--config", "zizmor.yml", "--no-progress", "{{files}}")
      }
      effect = "read"
    }
    fix = null
  }
  // .zavet/bin/zavet is vendored and regenerated by `zavet adapters`, so its
  // shell is not ours to lint.
  ["shellcheck"] = (Builtins.shellcheck) { exclude = List(".zavet/bin/**") }
  // `--format brief` prints file:line:col for every finding. The builtin's `--diff`
  // mode prints no file or line when a word has several suggestions.
  // `--force-exclude` makes the `[files]` excludes in typos.toml apply to the files
  // hk passes by name, which they otherwise skip. Exclusions live in typos.toml.
  ["typos"] = (Builtins.typos) {
    check = new CommandSpec {
      command = new Command {
        argv = List("typos", "--format", "brief", "--force-exclude", "{{files}}")
      }
      effect = "read"
    }
  }
  ["gitleaks"] = Builtins.gitleaks
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["trailing_whitespace"] = (Builtins.trailing_whitespace) { exclude = generated }
  // Rust. Fixes on pre-commit, checks in `hk check`. clippy is not a step here:
  // it is too slow for a commit hook and ci.yml already runs it.
  //
  // The builtin hardcodes `--edition 2024`, but this workspace is edition 2021
  // (Cargo.toml `[workspace.package]`), and 2024's style edition formats differently:
  // the builtin as shipped rejects files `cargo fmt --all -- --check` accepts. Pinning
  // 2021 here keeps the hook in agreement with `just check` and the CI `fmt` step.
  ["rustfmt"] = (Builtins.rustfmt) {
    check = "rustfmt --check --edition 2021 {{files}}"
    fix = "rustfmt --edition 2021 {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = (linters) {
      // On commit, scan what is staged rather than the whole working tree.
      ["gitleaks"] = new Step {
        check = new CommandSpec {
          command = new Command {
            argv = List("gitleaks", "git", "--pre-commit", "--redact", "--staged", "--verbose", "--no-banner")
          }
          effect = "read"
        }
      }
      ["zavet-nudge"] = Zavet.nudge
    }
  }
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
      ["zavet-guard"] = Zavet.guard
    }
  }
  ["check"] { steps = linters }
  ["fix"] {
    fix = true
    steps = linters
  }
}
